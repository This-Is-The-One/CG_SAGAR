managed implementation in class zbp_sgr_i_emp_crud unique;
strict ( 2 );
with draft;

define behavior for ZSGR_I_EMP_CRUD //alias <alias_name>
draft table zsgr_emp_t01_dt
persistent table zsgr_emp_t01
lock master total etag LastChangedAt
authorization master ( instance )
etag master LastChangedAt
early numbering

{
  validation validateEmail on save { create; field EmailId; }
  create ( authorization : global );

  update;
  delete;
  field ( readonly ) EmpId, CreatedAt, CreatedBy, LastChangedAt, LastChangedBy;
  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare
  {
    validation validateEmail;
  }
////  static action getData;
  mapping for zsgr_emp_t01
    {
      Doj            = doj;
      EmpId          = emp_id;
      EmailId        = email_id;
      LastName       = last_name;
      PhoneNum       = phone_num;
      FirstName      = first_name;
      ManagerId      = manager_id;
      OfficeLoc      = office_loc;
      CreatedBy      = created_by;
      CreatedAt      = created_at;
      Designation    = designation;
      DepartmentId   = department_id;
      LastChangedBy  = last_changed_by;
      LastChangedAt  = last_changed_at;
      DepartmentName = department_name;
    }
}